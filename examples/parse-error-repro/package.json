{
  "name": "@lynx-doctor-example/parse-error-repro",
  "version": "0.1.0",
  "private": true,
  "description": "Reproduce a source parse failure and compare published and local Lynx Doctor behavior.",
  "type": "module",
  "scripts": {
    "repro": "node prepare.mjs && npx --yes lynx-doctor@0.1.1 --no-agent-select",
